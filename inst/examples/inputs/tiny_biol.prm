C_uptake_GRN 0.5
C_uptake_DIA 0.5
# affinity coefficient for phosphorus uptake mechanism - read in for each primary producer.
P_scale_uptake_GRN 0.318e-03
P_scale_uptake_DIA 0.518e-03
# affinity coefficient for carbon uptake mechanism - read in for each primary producer.
C_scale_uptake_GRN 0.318e-03
C_scale_uptake_DIA 0.518e-03
#RMF found that this is NOT read in by the code
# internal phosphorus concentration factor - read in for each primary producer.
P_concp_GRN 0.250e6
P_concp_DIA 0.250e6
# internal carbon concentration factor - read in for each primary producer.
C_concp_GRN 0.250e6
C_concp_DIA 0.250e6
RMF 070717 found that this is NOT read in by the code
# Min quota of phosphorus in primary producer cells in moles/mg dry weight
PSA_min_GRN 1.6e-08
PSA_min_DIA 1.6e-08
# Min quota of carbon in primary producer cells in moles/mg dry weight NEEDS TO BE CHANGED TO MG RMF
C_min_GRN 1.6e-08
C_min_DIA 1.6e-08
# Phytoplankton respiration rate per second.(**Represents resp and Linear mortality as of 071117)
Phyto_Resp_Rate_GRN 0.05 # 0.05 0.01 new value from bowie 1985 RMF (.03-.25)
Phyto_Resp_Rate_DIA 0.05 #0.01 new value from bowie 1985 RMF (.03-.25) likely on lower end
# PValue = ((P1 - PRatio)/(P1 - P0)) * (amt_p/(KP_sp + amt_p)); where P1=P_max_interal_XXX and P0=P_min_internal_XXX
#max phosphorus uptake rate per day
#New values are in paper RMF
P_max_storage_uptake_GRN 0.065
P_max_storage_uptake_DIA 0.065
#RMF 070717 found that these are NOT read in by the code
P_min_storage_uptake_GRN 0.06
P_min_storage_uptake_DIA 0.06
#This is the value read in as PSA_min, the minimum concentration of phosphorus allowed in the corresponding phytoplankton
#These values for GRN, DIA, BLU found by RMF in Bierman et al #1980 given as .0005mgP/mg DW was divided by (5.7*2) to get it #into mg P/ mg N
P_min_internal_GRN 4.386e-05 #RMF 070717 0.06
P_min_internal_DIA 4.386e-05 #RMF 070717 0.06
#This is read in as P1
#RMF 070717 got values from Bowie 1985 p344 range of .013-.03mg/mg DW is given across all phytoplankton (was translated into mgP/DW N by dividing value by (5.7*2)for a range of 1.4e-0.3 to 2.63e-0.3
#These values may need further calibration
P_max_internal_GRN 0.065 #0.065
P_max_internal_DIA 0.065 #0.065
