# The parameter files was modified by yzhao on Oct 2022 to using new bgm files and initial condition files
# UNLESS OTHERWISE STATED ALL PARAMETERS TAKEN FROM NSW MODEL (OCTOBER 2006 NSW version)
# adapted from NSW version for VMPA model from latest version of vmpa_biol.txt
# Sept 6
## Biological parameter file for use with the NSW version of the Boxmodel (Atlantis) model
# modified from Hongyan's file
## For reference, the following are the codenames for each biological component.
# Those marked with a + also have Si pool too. Those marked special have three pools, a structural N
# (mg N individual-1), reserve N (mg N individual-1) and numbers (per box)
# Description Symbol Units
###########################
# Gizzard_Shad GZS
# Alewife ALE
# Burbot BBT
# Walleye WAE
# Salmons STH
# Lake_Trout LKT
# Rainbow_Smelt RSM
# Round_Goby RDG
# White_Bass WBS
# White_Perch WPH
# Lake_Whitefish LWF
# Yellow_Perch YPH
# Rock_SM bass SBS
# Silver_Chub ESH
# Channel_Catfish CAT
# White_Sucker SKR
# Freshwater_Drum FDM
##############################
# Dressenids DRE mg N m-2
# Amphipods AMP mg N m-2
# Chironomids CHI mg N m-2
# Oligochaetes OLI mg N m-2
# Protozoa (Nametoda) PRO mg N m-3
# Hexagenia HEX mg N m-2
##########################
# Diatoms DIA mg N m-3 +
# Blue Green Algae (Cyanobacteria) BLU mg N m-3
# Green Algae GRN mg N m-3
# ##########################
# Calanoida CAL mg N m-3
# Cyclopoida CYC mg N m-3
# Cladocerans (Daphnia) CLA mg N m-3
# Small cladocerans SCL (Bosmina) mg N m-3
# Bythotrephes BYT mg N m-3
# Rotifers ROT mg N m-3
######################################
# Pelagic associated bacteria PB mg N m-2
# Sedimentary bacteria BB mg N m-2
#################################
# Labile detritus DL mg N m-3
# Refractory detritus DR mg N m-3
# Carrion (detritus) DC mg N m-3
##########################################
# Dissolved organic nitrogen DON mg N m-3
# Ammonia NH mg N m-3
# Nitrate NO mg N m-3
# Dissolved silica Si mg Si m-3
# Biogenic silica DSi mg Si m-3
# Dissolved oxygen O2 mg O m-3
# Light IRR W m-2
#########################
## Flags and switches
# Those determining set-up and recording
ecotest 0 Messages: 0=no, 1=part, 2=more, 3=all, 4=fluxs, 5= do 1 iter only 2
availflag 1 Switch to filter flows based on active groups 1
flagrandom 0 Flag indicating whether add random wobble in aging/spawning dates (0=no, 1=yes)
# Parameters defining the numbers of certain types of groups (needed to define parameter arrays in the
# initialisation section of the model, best left untouched for now)
K_num_invmig 9 Maximum number of vertically migrating invertebrate groups 9
readin_popratio 0 Switch to indicate whether loading pre-existing age distributions or not 0
# If fish respiration is off then the fish model is essentially/very similar to a Deriso-Schnute
flagresp 0 Switch to turn fish respiration on/off: off=0, on=1
flag_benthos_sediment_link 0
UseHardFeedingWindow 1
flagavgmig 0 Switch to turn averaging of migrant sizes on/off: off=0, on=1 1
flagkdrop 0 Switch to turn cubic bacterial growth on/off: off=0, on=1 0
flagbactstim 0 Switch to turn stimulation of bacterial growth on/off: off=0, on=1 0
flagBOlim 1 Switch to turn OB population limitation on/off: off=0, on=1 0
flagBDlim 1 Switch to turn BD population limitation on/off: off=0, on=1 0
flagBGlim 1 Switch to turn BG population limitation on/off: off=0, on=1 (1) 0
flagBFlim 1 Switch to identify filter feeding crowding used: simple=0, ERSEM=1 0
flagSiLim 0
flagCHIlim 0 Switch to turn CHI population limitation on/off: off=0, on=1 0
flagDRElim 1 Switch to identify filter feeding crowding used: simple=0, ERSEM=1 0
flagSPHlim 0
# Those determining which environmental
# interaction formulations used
flagtrackpops 1 Flag to indicate whether yearly stock value required 1
flagseason 1 Flag of seasonal change, 0 for no, 1 yes 1
flaglight 0 Light adaptation: 1 = on, 0 = off 1
flagIsEstuary 0
flaglightopt 0 Light model: 0=orig, 1=bottom, 2=top, 3=mid-depth of cell 3
flagmodeltemp 0 Temperature model used: 1 = regression, 0 = from data 1
flagmodelpH 0
flagmodelArag 0 #added rmf 060817
flagq10 1 Q10 corrections used in the model: 1 = yes, 0 = no 1
O2case 3 Oxygen limitation used: 0 = ambient O2, 1 = based on depth, 2 = IGBEM, 3 = quadratic lim 3
flagnut 0 Nutrient lim used: 0=Leibig (min), 1=multiplicative, 2=WQI 0
flagmicro 0 Nutrient lim by micronutrient: 0 = no, 1 = yes 0
flagtempchange 0 Mean temperature changes: 0 = no, 1 = yes 0
flagsaltchange 0 Mean salinity changes: 0 = no, 1 = yes 0
flagstarve 1 Give starvation notices: 0 = no, 1 = yes 0
flagdegrade 0 Degrade coastal habitats (effects growth of MA, SG and OLI) 0
flagroc 0 Density dependent drop off option: 0 = none, 1 = ratio drop off, 2 = exponential decline 0
flaghomog_sp 1 Body condition homogenised across the entire area: 0 = no, 1 = yes 0
flagagestruct 1 Age structure option: 0 = homogeneous cohorts, 1 = track cohorts 0
flagsenesce 0 Oldest sub-part of final age group senesces, 1 = yes, 0 = no 0
flagtsforcerecruit 0 Force recruitment of 1+ groups with environmental forcing 0
lim_sun_hours 0 Whether using limted hours of sun oer day or the default assumption of half the day is "day"
flag_macro_model 0
flag_fine_ontogenetic_diets 0
flag_olddiet 1
# the following are added on Dec 6-2023 running 6698 based on atlantisboxmodel code--zhao
flaggape 0 Wheather reporting gape limitation
flagchecksize 0 whether want to output current size vs initial conditions
flagagecheck 0 check age structure when reporting on size of verbrates (flagchecksize)
flagenviro_warn 0 Flag indicating that whether want earnings anout environmental constraints on movement recorded to the logfile
flagenviro_kill 0 0 = animals leave the domain, 1 = die in place
flagenviro_displace 0 0 = redistribute over eeh entire domain, 1 = moe to adjacent only
flagtempdepend_move 0
flagtempdepend_reprod 0
# Groups functioning
##
##
flagRDG 1 RDG: 1 = on, 0 = off 1
flagWAE 1 WAE: 1 = on, 0 = off 1
flagYPH 1 YPH: 1 = on, 0 = off 1
flagGZS 1 GZS: 1 = on, 0 = off 1
flagDRE 1 DRE: 1 = on, 0 = off 1
flagCHI 1 CHI: 1 = on, 0 = off 1
flagROT 1 ROT: 1 = on, 0 = off 1
flagCAL 1 CAL: 1 = on, 0 = off 1
flagPB 1 PB: 1 = on, 0 = off 1
flagBB 1 BB: 1 = on, 0 = off 1
flagDIA 1 DIA: 1 = on, 0 = off 1
flagGRN 1 GRN: 1 = on, 0 = off 1
flagDL 1
flagDC 1
flagDR 1
# Preferred location trend (whether to weight vertical distributions towards surface or bottom
# layers when in depths where there were less than complete set of depth layers. 0 is top, 1 is demersal (?))
flagdemRDG 1 RDG: 1 = on, 0 = off 1
flagdemYPH 0 YPH: 1 = on, 0 = off 1
flagdemWAE 0 WAE: 1 = on, 0 = off 1
flagdemGZS 0 GZS: 1 = on, 0 = off 1
flagdemDRE 1 DRE: 1 = on, 0 = off 1
flagdemCHI 1 CHI: 1 = on, 0 = off 1
flagdemROT 0 ROT: 1 = on, 0 = off 1
flagdemCAL 0 CAL: 1 = on, 0 = off 1
flagdemPB 0 PB: 1 = on, 0 = off 1
flagdemBB 1 BB: 1 = on, 0 = off 1
flagdemDIA 0 DIA: 1 = on, 0 = off 1
flagdemGRN 0 GRN: 1 = on, 0 = off 1
# Flag indicating whether or not the vertebrate is a planktivore
flagplankfishRDG 0 RDG: 1 = yes, 0 = no 1
flagplankfishYPH 0 YPH: 1 = yes, 0 = no 1
flagplankfishWAE 0 WAE: 1 = yes, 0 = no 1
flagplankfishGZS 1 GZS: 1 = yes, 0 = no 1
# Identifier indicating whether vertebrate group is parametrized as a bird (1 = yes, 0 = no)
isbirdCMT 1 CMT: 1 = yes, 0 = no 1
isbirdMGR 1 MGR: 1 = yes, 0 = no 1
# Recruitment flags
flagtrecruitdistrib 1 0=humped recruit arrival distrib, 1=flat distrib of recruits 1
# Vertebrate reproduction related flags. The flagrecruit entries refer to the recruitment function used.
# 1=const, 2=dependent on prim producers (Chla), 3=Beverton-Holt, 4=lognormal, 5=dependent on all plankton
# groups not just Chla, 6=Bev-Holt with lognormal variation added, 7=Bev-Holt with encourage recovery
# 8=Bev-Holt with perscribed recovery, 9=Ricker, 10=Standard Bev-Holt (no explict use of spawn included)
# 11=pupping/calving linearly dependent on maternal condition, 12=pupping/calving a fixed number per adult
# spawning, 13=forced timeseries of recruitment; Baltic_Ricker=17; 18=multiple recruitment tiem series turning up in different boxes;
flagrecruitRDG 3
flagrecruitYPH 3
flagrecruitWAE 3
flagrecruitGZS 3
#flagstocking- Flag indicating where functional group XX has input time series of stocking. 0=off, 1=on.
#If set to 1 it triggers the same code as if flagrecruit is set to option 18. This stocking will happen in addition to any natural recruitment.
flagstockingRDG 0
flagstockingYPH 0
flagstockingWAE 0
flagstockingSLP 0
flagstockingGZS 0
# External reproduction - spawn is based on adult population within model domain, but actual reproduction
# occurs outside model domain (0 = no, 1 = yes)
flagext_reprodRDG 0
flagext_reprodYPH 0
flagext_reprodWAE 0
flagext_reprodGZS 0
flagext_reprodCMC 0
# Vertebrate reproduction strength flags (1=very strong year classes possible, relative strength
# set using recruitRange and 0=only moderate variation in year class strength possible, mainly
# for top predators with few young per reproductive event, relative strength set using recruitRangeFlat)
flagrecpeakRDG 1
flagrecpeakYPH 1
flagrecpeakWAE 1
flagrecpeakSLP 1
flagrecpeakGZS 1
# Local recruitment (1 = demersal and piscivorous fish recruit at parental locations, 0 = independent distribution)
flaglocalrecruitRDG 0
flaglocalrecruitYPH 0
flaglocalrecruitWAE 1
flaglocalrecruitGZS 0
flaglocalrecruitSSH 0
# Flag indicating whether the vertebrate group bears live young (0 = no, 1 = yes)
flagbearliveRDG 0
flagbearliveYPH 0
flagbearliveWAE 0
flagbearliveGZS 0
flagbearliveSSH 0
# Flag indicating whether the vertebrate group provides parental care for young until maturity
# (0 = no, 1 = yes, -1 = semelparous so die after reproduction)
#modified yzhao oct25, 2022
flagmotherRDG 0
flagmotherYPH 0
flagmotherWAE 0
flagmotherGZS 0
flagmotherCMC 0
# Flag indicating whether feed during the spawning period (0 = no, 1 = yes)
feed_while_spawnRDG 1
feed_while_spawnYPH 1
feed_while_spawnWAE 1
feed_while_spawnGZS 1
feed_while_spawnSSH 1
UseBiLogisticFeedingWindow 0
