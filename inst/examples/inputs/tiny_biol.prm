# Added by Bec Gorton 23rd April 2013.
# Jacknife recruitment flagrecruitXXX=15
# The jack_a_XXX is interpreted as slope of recruitment, usually set as biomass of recruits / SSB.
# The jack_b_XXX is empirical proxy for a relationship with the carrying capacity
# (in the North Sea they used 0.3 * long term average total biomass).
# This recruitment relationship is taken from the North Sea stock assessment -
# see a more detailed description on the wiki
